{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixFlow",
  "version": "0.1.0",
  "identifier": "com.mixflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MixFlow",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
